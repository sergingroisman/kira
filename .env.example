# Copy this file to .env and fill in values.
# .env is gitignored. NEVER commit secrets.
# chmod 600 .env recommended.

# DashScope (Alibaba) — Qwen models. Internacional Singapore endpoint.
# Get key: https://www.alibabacloud.com/help/en/model-studio (Create API Key)
DASHSCOPE_API_KEY=sk-...

# DeepSeek — DeepSeek V4 Pro/Flash. (Add when ready.)
# Get key: https://platform.deepseek.com/api_keys
# DEEPSEEK_API_KEY=sk-...

# SiliconFlow (v0.5) — agregador chinês.
# SILICONFLOW_API_KEY=sk-...

# OpenRouter (v0.5, OPT-IN ONLY — eval framework, never hot path).
# OPENROUTER_API_KEY=sk-or-...

# Daemon overrides (optional)
# KIRA_LOG_FORMAT=pretty
# RUST_LOG=kira_core=debug,tower_http=info,info
